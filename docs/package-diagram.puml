@startuml AppleStore_Package_Diagram

title AppleStore - Package Diagram
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #52606D
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #475569
}

package "Web Layer" {
  package "controller" as controller
  package "filter" as filter
  package "listener" as listener
}

package "Application Layer" {
  package "service" as service
}

package "Persistence Layer" {
  package "dao" as dao
}

package "Domain Model" {
  package "model.entity" as entity
  package "dto" as dto
}

package "Infrastructure" {
  package "config" as config
  package "util" as util
}

database "MySQL Database" as db

' Main architectural dependencies
controller ..> service : invokes
controller ..> entity : uses
controller ..> dto : uses
controller ..> util : uses

filter ..> controller : protects/routes
filter ..> service : validates session/role
listener ..> service : schedules jobs

service ..> dao : delegates persistence
service ..> entity : manages
service ..> dto : produces/consumes
service ..> util : uses
service ..> config : reads settings

dao ..> entity : maps data
dao ..> util : opens connections
dao ..> db : SQL / JDBC

config ..> util : configures infrastructure

' Representative feature packages
package "Feature Modules" {
  package "catalog" as catalog
  package "cart" as cart
  package "order" as order
  package "payment" as payment
  package "promotion" as promotion
  package "review" as review
  package "user" as user
  package "staff" as staff
}

controller ..> catalog
controller ..> cart
controller ..> order
controller ..> payment
controller ..> promotion
controller ..> review
controller ..> user
controller ..> staff

catalog ..> service
catalog ..> dao
catalog ..> entity

cart ..> service
cart ..> dao
cart ..> entity

order ..> service
order ..> dao
order ..> entity

payment ..> service
payment ..> dao
payment ..> entity

promotion ..> service
promotion ..> dao
promotion ..> entity

review ..> service
review ..> dao
review ..> entity

user ..> service
user ..> dao
user ..> entity

staff ..> service
staff ..> dao
staff ..> entity

note right of controller
  Java Servlets:
  admin, auth, customer,
  delivery, staff, webhook
end note

note right of dao
  DAO packages:
  catalog, cart, order,
  payment, promotion,
  review, user, dashboard
end note

note bottom of util
  DBConnection, ServletUtil,
  PasswordUtil, EmailUtil,
  FileUploadUtil, JsonUtil
end note

@enduml
