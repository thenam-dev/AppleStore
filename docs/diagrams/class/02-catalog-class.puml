@startuml
title Product Catalog Class Diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

class ProductListServlet <<guest>> {
  # doGet(request, response): void
  - showProductList(request, response): void
}
class ProductDetailServlet <<guest>> {
  # doGet(request, response): void
  - showProductDetail(request, response): void
  - loadActiveVariants(productId): List<ProductVariant>
  - pickDefaultVariant(variants): ProductVariant
}
class ProductService {
  + getProducts(keyword, categoryId, status, sort, page, pageSize): List<Product>
  + countProducts(keyword, categoryId, status): int
  + getProductById(productId): Product
  + createProduct(product): int
  + updateProduct(product): void
  + changeStatus(productId, status): void
}
class CategoryService {
  + getCategories(keyword, status, sort, page, pageSize): List<Category>
  + getActiveCategories(): List<Category>
  + getCategoryById(categoryId): Category
  + createCategory(category): int
  + updateCategory(category): void
  + changeCategoryStatus(categoryId, status): void
}
class ProductVariantService {
  + getVariants(productId, keyword, status, sort, page, pageSize): List<ProductVariant>
  + getVariantById(variantId): ProductVariant
  + createVariant(variant): int
  + updateVariant(variant): void
  + changeStatus(productId, variantId, active): void
}
class ProductImageService {
  + getImagesByProductId(productId): List<ProductImage>
  + uploadImages(productId, parts): int
  + setPrimary(productId, imageId): void
  + deleteImage(productId, imageId): void
}
class ProductSpecificationService {
  + getSpecifications(productId): List<ProductSpecification>
  + replaceSpecifications(productId, specifications): void
}
class ProductDAO {
  + findAll(keyword, categoryId, status, sort, page, pageSize): List<Product>
  + countAll(keyword, categoryId, status): int
  + findById(productId): Optional<Product>
  + insert(product): int
  + update(product): boolean
  + updateStatus(productId, status): boolean
}
class CategoryDAO {
  + findAllActive(): List<Category>
  + findById(categoryId): Optional<Category>
  + insert(category): int
  + update(category): boolean
}
class ProductVariantDAO
class ProductImageDAO
class ProductSpecificationDAO
class ReviewDAO
class Product
class Category
class ProductVariant
class ProductImage
class ProductSpecification
class Review

ProductListServlet --> ProductDAO
ProductListServlet --> CategoryDAO
ProductDetailServlet --> ProductDAO
ProductDetailServlet --> ProductVariantDAO
ProductDetailServlet --> ProductImageService
ProductDetailServlet --> ProductSpecificationService
ProductDetailServlet --> ReviewDAO
ProductService --> ProductDAO
ProductService --> CategoryDAO
CategoryService --> CategoryDAO
CategoryService --> ProductDAO
ProductVariantService --> ProductVariantDAO
ProductImageService --> ProductImageDAO
ProductSpecificationService --> ProductSpecificationDAO
ProductDAO --> Product
CategoryDAO --> Category
ProductVariantDAO --> ProductVariant
ProductImageDAO --> ProductImage
ProductSpecificationDAO --> ProductSpecification
ReviewDAO --> Review
Category "1" <-- "0..*" Product
Product "1" *-- "0..*" ProductVariant
Product "1" *-- "0..*" ProductImage
Product "1" *-- "0..*" ProductSpecification
@enduml
