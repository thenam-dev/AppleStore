@startuml
title Order, Payment and Delivery Class Diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

class CustomerOrdersServlet
class PaymentStatusServlet
class SepayWebhookServlet {
  # doPost(request, response): void
  - isAuthorized(request): boolean
  - readRawBody(request): String
}
class StaffOrderStatusServlet
class DeliveryTaskListServlet
class DeliveryCompleteServlet
class OrderService {
  + getCustomerOrders(customerId, tab): List<Map>
  + getSelectedOrderDetail(orderId, customerId): Map
  + cancelOrder(orderId, customerId): boolean
}
class PaymentService {
  + getPaymentPageData(orderId, customerId): PaymentPageResult
  + getOrderStatusForCustomer(orderId, customerId): String
  + processSepayWebhook(payload, rawBody): WebhookResult
}
class StaffOrderService {
  + getFilteredOrdersByRole(role, userId, filter, status, keyword, offset, limit): List<Order>
  + updateOrderStatus(orderId, newStatus, staffId, role, note): void
  + getShipperTasks(shipperId): List<Map>
  + completeDelivery(orderId, shipperId): void
}
class OrderDAO {
  + findById(orderId): Optional<Order>
  + cancelOrderByCustomer(orderId, customerId): boolean
  + updateStatus(orderId, status): boolean
  + insertStatusHistory(orderId, status, changedBy, note): void
}
class PaymentDAO {
  + tryClaimWebhookTransaction(sepayId, orderCode): boolean
  + findLatestPendingAmount(orderId): Optional<BigDecimal>
  + markLatestCompletedFromWebhook(orderId, sepayId, reference): boolean
}
class StaffOrderDAO
class Order
class OrderItem
class OrderStatusHistory
class PaymentTransaction

CustomerOrdersServlet --> OrderService
PaymentStatusServlet --> PaymentService
SepayWebhookServlet --> PaymentService
StaffOrderStatusServlet --> StaffOrderService
DeliveryTaskListServlet --> StaffOrderService
DeliveryCompleteServlet --> StaffOrderService
OrderService --> OrderDAO
PaymentService --> PaymentDAO
PaymentService --> OrderDAO
StaffOrderService --> StaffOrderDAO
OrderDAO --> Order
Order "1" *-- "1..*" OrderItem
Order "1" *-- "1..*" OrderStatusHistory
Order "1" --> "0..*" PaymentTransaction
@enduml
