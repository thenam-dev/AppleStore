@startuml
title Authentication Class Diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

class LoginServlet {
  # doGet(request, response): void
  # doPost(request, response): void
  - sanitizeRedirect(redirectTo): String
}
class RegisterServlet {
  # doGet(request, response): void
  # doPost(request, response): void
}
class GoogleLoginServlet {
  # doGet(request, response): void
}
class GoogleCallbackServlet {
  # doGet(request, response): void
  - exchangeCodeForToken(req, code): Map
  - fetchGoogleUserProfile(accessToken): Map
}
class ForgotPasswordServlet {
  # doGet(request, response): void
  # doPost(request, response): void
}
class ChangePasswordServlet {
  # doGet(request, response): void
  # doPost(request, response): void
}
class AuthService {
  + register(fullName, email, phone, password, confirmPassword): RegisterResult
  + login(email, password): LoginResult
  + changePassword(userId, currentPassword, newPassword, confirmPassword): ChangePasswordResult
  + processGoogleLogin(email, fullName, pictureUrl, googleId): LoginResult
}
class UserDAO {
  + findByEmail(email): Optional<User>
  + existsByEmail(email): boolean
  + existsByPhone(phone): boolean
  + insertCustomer(user, passwordHash): int
  + insertGoogleCustomer(user): int
  + recordLoginSuccess(userId): void
  + recordLoginFailure(userId, failedCount, lockedUntil): void
  + updatePasswordByEmail(email, hash): boolean
  + updatePasswordHash(userId, hash): boolean
}
class PasswordUtil <<utility>> {
  + hash(rawPassword): String
  + matches(rawPassword, storedHash): boolean
}
class EmailUtil <<utility>> {
  + sendOtpEmail(recipientEmail, otpCode): void
}
class JsonUtil <<utility>> {
  + fromJson(json, clazz): Map
  + toJson(value): String
}
class User {
  - userId: int
  - email: String
  - fullName: String
  - phone: String
  - role: String
  - status: String
  - failedLoginCount: int
  - lockedUntil: LocalDateTime
}

LoginServlet --> AuthService
RegisterServlet --> AuthService
GoogleCallbackServlet --> AuthService
ChangePasswordServlet --> AuthService
ForgotPasswordServlet --> UserDAO
ForgotPasswordServlet ..> EmailUtil
ForgotPasswordServlet ..> PasswordUtil
GoogleCallbackServlet ..> JsonUtil
AuthService --> UserDAO
AuthService ..> PasswordUtil
UserDAO --> User
@enduml
