@startuml
title Administration Class Diagram
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

class CategoryUpdateServlet
class CategoryStatusServlet
class ProductUpdateServlet
class ProductStatusServlet
class VariantUpdateServlet
class VariantStatusServlet
class ProductSpecificationUpdateServlet
class ProductImageUploadServlet
class ProductImagePrimaryServlet
class ProductImageDeleteServlet
class UserUpdateServlet
class UserStatusServlet
class CustomerStatusServlet
class CategoryService
class ProductService
class ProductVariantService
class ProductSpecificationService
class ProductImageService
class UserService {
  + updateStaffUser(user, actorUserId): void
  + changeStaffStatus(userId, status, actorUserId): void
  + changeCustomerStatus(userId, status): void
}
class CategoryDAO
class ProductDAO
class ProductVariantDAO
class ProductSpecificationDAO
class ProductImageDAO
class UserDAO {
  + update(user): boolean
  + updateStatus(userId, status): boolean
  + existsByEmailForOtherUser(email, userId): boolean
  + existsByPhoneForOtherUser(phone, userId): boolean
  + countUnfinishedCustomerOrders(customerId): int
  + countActiveAdmins(): int
}
class FileUploadUtil <<utility>> {
  + saveProductImage(part): String
  + validateProductImage(part): void
  + deleteUploadedFile(storedPath): void
}

CategoryUpdateServlet --> CategoryService
CategoryStatusServlet --> CategoryService
ProductUpdateServlet --> ProductService
ProductStatusServlet --> ProductService
VariantUpdateServlet --> ProductVariantService
VariantStatusServlet --> ProductVariantService
ProductSpecificationUpdateServlet --> ProductSpecificationService
ProductImageUploadServlet --> ProductImageService
ProductImagePrimaryServlet --> ProductImageService
ProductImageDeleteServlet --> ProductImageService
UserUpdateServlet --> UserService
UserStatusServlet --> UserService
CustomerStatusServlet --> UserService
CategoryService --> CategoryDAO
ProductService --> ProductDAO
ProductVariantService --> ProductVariantDAO
ProductSpecificationService --> ProductSpecificationDAO
ProductImageService --> ProductImageDAO
ProductImageService ..> FileUploadUtil
UserService --> UserDAO
CategoryService -[hidden]down-> ProductService
ProductService -[hidden]down-> ProductVariantService
ProductVariantService -[hidden]down-> ProductSpecificationService
ProductSpecificationService -[hidden]down-> ProductImageService
ProductImageService -[hidden]down-> UserService
@enduml
