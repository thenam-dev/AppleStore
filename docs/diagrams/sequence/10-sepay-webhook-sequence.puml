@startuml
title Process SePay Webhook Sequence Diagram
!theme plain
autonumber
participant SePay
control SepayWebhookServlet
control JsonUtil
control PaymentService
database PaymentDAO
database OrderDAO
database MySQL
control PaymentStatusServlet
boundary "payment.jsp" as PaymentJSP

SePay -> SepayWebhookServlet: POST webhook JSON + API key
SepayWebhookServlet -> SepayWebhookServlet: isAuthorized(request)
alt invalid API key
  SepayWebhookServlet --> SePay: HTTP 401 JSON
else authorized
  SepayWebhookServlet -> SepayWebhookServlet: readRawBody(request)
  SepayWebhookServlet -> JsonUtil: fromJson(rawBody, Map.class)
  JsonUtil --> SepayWebhookServlet: payload
  SepayWebhookServlet -> PaymentService: processSepayWebhook(payload, rawBody)
  PaymentService -> PaymentDAO: tryClaimWebhookTransaction(sepayId, orderCode)
  PaymentDAO -> MySQL: INSERT sepay_webhook_dedup
  alt duplicate webhook
    MySQL --> PaymentDAO: duplicate
    PaymentService --> SepayWebhookServlet: WebhookResult(idempotent)
  else first delivery
    PaymentService -> PaymentService: verify transfer direction,\nextractOrderId(content)
    PaymentService -> OrderDAO: findById(orderId)
    OrderDAO -> MySQL: SELECT order
    alt order missing or method is not CK
      PaymentService -> PaymentDAO: updateWebhookDedupResult(..., rejected)
    else amount mismatch
      PaymentService -> PaymentDAO: findLatestPendingAmount(orderId)
      PaymentDAO -> MySQL: SELECT pending amount
      PaymentService -> PaymentDAO: updateWebhookDedupResult(..., mismatch)
    else valid incoming transfer
      PaymentService -> PaymentDAO: markLatestCompletedFromWebhook(orderId, sepayId, reference)
      PaymentDAO -> MySQL: UPDATE payment PENDING -> COMPLETED
      PaymentService -> OrderDAO: updateStatus(orderId, "CONFIRMED")
      PaymentService -> OrderDAO: insertStatusHistory(orderId, "CONFIRMED", null, note)
      PaymentService -> PaymentDAO: updateWebhookDedupResult(..., completed)
    end
  end
  SepayWebhookServlet --> SePay: HTTP 200 JSON
end

loop poll until terminal status
  PaymentJSP -> PaymentStatusServlet: GET /payment/status?orderId=...
  PaymentStatusServlet -> PaymentService: getOrderStatusForCustomer(orderId, customerId)
  PaymentService -> OrderDAO: findById(orderId)
  OrderDAO -> MySQL: SELECT status
  PaymentStatusServlet --> PaymentJSP: JSON status
end
PaymentJSP -> PaymentJSP: redirect order success when CONFIRMED
@enduml
