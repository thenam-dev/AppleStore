@startuml
title Forgot and Reset Password Sequence Diagram
!theme plain
autonumber
actor User
boundary "forgot-password.jsp" as ForgotJSP
control ForgotPasswordServlet
database UserDAO
control EmailUtil
participant "Gmail SMTP" as Gmail
collections HttpSession
boundary "verify-otp.jsp" as OtpJSP
boundary "reset-password.jsp" as ResetJSP
control PasswordUtil
database MySQL

User -> ForgotJSP: Enter email
ForgotJSP -> ForgotPasswordServlet: POST action=sendEmail
ForgotPasswordServlet -> UserDAO: findByEmail(email)
UserDAO -> MySQL: SELECT user by email
alt email does not exist
  MySQL --> UserDAO: empty
  ForgotPasswordServlet -> ForgotJSP: forward(error)
else email exists
  ForgotPasswordServlet -> ForgotPasswordServlet: generate six-digit OTP
  ForgotPasswordServlet -> HttpSession: store resetOtp, resetEmail,\notpAttempts=0
  ForgotPasswordServlet -> EmailUtil: sendOtpEmail(email, otp)
  EmailUtil -> Gmail: send message
  Gmail --> EmailUtil: accepted
  ForgotPasswordServlet -> OtpJSP: redirect step=verify
  User -> OtpJSP: Enter OTP
  OtpJSP -> ForgotPasswordServlet: POST action=verifyOtp
  ForgotPasswordServlet -> HttpSession: read OTP and attempts
  alt attempts >= 5
    ForgotPasswordServlet -> HttpSession: clear OTP state
    ForgotPasswordServlet -> ForgotJSP: forward(error)
  else wrong or missing OTP
    ForgotPasswordServlet -> HttpSession: increment otpAttempts
    ForgotPasswordServlet -> OtpJSP: forward(error)
  else OTP accepted
    ForgotPasswordServlet -> HttpSession: set otpVerified=true
    ForgotPasswordServlet -> ResetJSP: redirect step=reset
    User -> ResetJSP: Enter new password and confirmation
    ResetJSP -> ForgotPasswordServlet: POST action=resetPassword
    alt not verified or mismatch
      ForgotPasswordServlet -> ResetJSP: forward(error)
    else reset success
      ForgotPasswordServlet -> PasswordUtil: hash(newPassword)
      PasswordUtil --> ForgotPasswordServlet: passwordHash
      ForgotPasswordServlet -> UserDAO: updatePasswordByEmail(email, hash)
      UserDAO -> MySQL: UPDATE password_hash
      ForgotPasswordServlet -> HttpSession: clear reset state
      ForgotPasswordServlet -> User: redirect /login with successMsg
    end
  end
end
note over ForgotPasswordServlet,HttpSession
Source does not store an OTP expiry timestamp;
"expired" is currently treated as missing/invalid OTP.
end note
@enduml
