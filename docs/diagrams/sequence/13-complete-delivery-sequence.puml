@startuml
title Complete Delivery Sequence Diagram
!theme plain
autonumber
actor "Delivery Staff" as Delivery
boundary "staff/tasks.jsp" as JSP
control DeliveryTaskListServlet
control DeliveryCompleteServlet
control StaffOrderService
database StaffOrderDAO
database MySQL

Delivery -> DeliveryTaskListServlet: GET /staff/tasks
DeliveryTaskListServlet -> StaffOrderService: getShipperTasks(shipperId)
StaffOrderService -> StaffOrderDAO: findTasksByShipper(shipperId)
StaffOrderDAO -> MySQL: SELECT assigned delivery tasks
MySQL --> StaffOrderDAO: tasks
DeliveryTaskListServlet -> JSP: forward(tasks)
Delivery -> JSP: Confirm successful delivery
JSP -> DeliveryCompleteServlet: POST /delivery/complete(orderId)
alt missing session or role != DELIVERY
  DeliveryCompleteServlet --> Delivery: redirect /login
else authenticated Delivery Staff
  DeliveryCompleteServlet -> StaffOrderService: completeDelivery(orderId, shipperId)
  StaffOrderService -> StaffOrderDAO: updateDeliveryCompletedSecure(orderId, shipperId)
  StaffOrderDAO -> MySQL: verify assigned staff and current status
  alt unauthorized staff / wrong assignment
    MySQL --> StaffOrderDAO: false
    StaffOrderService --> DeliveryCompleteServlet: IllegalArgumentException
    DeliveryCompleteServlet -> JSP: redirect with error
  else database error
    MySQL --> StaffOrderDAO: SQLException
    StaffOrderService --> DeliveryCompleteServlet: SQLException
    DeliveryCompleteServlet -> JSP: redirect with error
  else assigned staff
    StaffOrderDAO -> MySQL: UPDATE deliveries status=DELIVERED,\norders status=DELIVERED, delivered_at=NOW()
    MySQL --> StaffOrderDAO: true
    StaffOrderService --> DeliveryCompleteServlet: success
    DeliveryCompleteServlet -> JSP: redirect with success message
  end
end
@enduml
