@startuml
title Login Sequence Diagram
!theme plain
autonumber
actor User
participant "Web Browser" as Browser
boundary "login.jsp" as JSP
control LoginServlet
control AuthService
database UserDAO
control PasswordUtil
database MySQL
collections HttpSession

User -> Browser: Enter email and password
Browser -> LoginServlet: POST /login
LoginServlet -> AuthService: login(email, password)
AuthService -> UserDAO: findByEmail(normalizedEmail)
UserDAO -> MySQL: SELECT user by email
MySQL --> UserDAO: user / empty
UserDAO --> AuthService: Optional<User>
alt account not found
  AuthService --> LoginServlet: LoginResult(false)
  LoginServlet -> JSP: forward(error)
else account locked or lockedUntil is in future
  AuthService --> LoginServlet: LoginResult("locked")
  LoginServlet -> JSP: forward(error)
else lock check passed
  AuthService -> PasswordUtil: matches(password, passwordHash)
  alt wrong password
    PasswordUtil --> AuthService: false
    AuthService -> UserDAO: recordLoginFailure(userId, count, lockedUntil)
    UserDAO -> MySQL: UPDATE failed_login_count, locked_until
    AuthService --> LoginServlet: LoginResult(false, attemptsLeft)
    LoginServlet -> JSP: forward(error, attemptsLeft)
  else password valid
    PasswordUtil --> AuthService: true
    alt account inactive / suspended / locked status
      AuthService --> LoginServlet: LoginResult("inactive or locked")
      LoginServlet -> JSP: forward(error)
    else active account
      AuthService -> UserDAO: recordLoginSuccess(userId)
      UserDAO -> MySQL: reset login failure fields
      AuthService --> LoginServlet: LoginResult(true, user)
      LoginServlet -> HttpSession: setAttribute(SESSION_USER, user)
      LoginServlet -> HttpSession: setMaxInactiveInterval(...)
      alt ADMIN
        LoginServlet -> Browser: redirect /admin/dashboard
      else SALE_STAFF
        LoginServlet -> Browser: redirect /staff/dashboard
      else DELIVERY
        LoginServlet -> Browser: redirect /delivery/dashboard
      else CUSTOMER
        LoginServlet -> Browser: redirect /home
      end
    end
  end
end
@enduml
