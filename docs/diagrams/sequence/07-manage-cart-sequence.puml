@startuml
title Manage Shopping Cart Sequence Diagram
!theme plain
autonumber
actor Customer
boundary "cart.jsp" as JSP
control CartServlet
control CartService
database CartDAO
database ProductVariantDAO
database MySQL

Customer -> JSP: Choose a cart action
JSP -> CartServlet: POST /cart (action, ids, quantity)
alt Add item
  CartServlet -> CartService: addToCart(customerId, variantId, quantity, addonId)
  CartService -> ProductVariantDAO: findById(variantId)
  ProductVariantDAO -> MySQL: SELECT variant and stock
  alt invalid/inactive/insufficient stock
    CartService --> CartServlet: Result(false, message)
  else valid variant
    CartService -> CartDAO: getOrCreateCartId(customerId)
    CartDAO -> MySQL: SELECT or INSERT cart
    CartService -> CartDAO: upsertCartItem(cartId, variantId, quantity, addonId)
    CartDAO -> MySQL: INSERT or UPDATE cart_items
  end
else Update quantity
  CartServlet -> CartService: updateQuantity(customerId, cartItemId, quantity)
  CartService -> CartDAO: findCartIdByCustomerId(customerId)
  CartService -> CartDAO: findById(cartItemId, cartId)
  CartService -> ProductVariantDAO: findStockQuantity(variantId)
  alt quantity exceeds stock
    CartService --> CartServlet: Result(false, message)
  else valid quantity
    CartService -> CartDAO: updateQuantity(cartItemId, cartId, quantity)
    CartDAO -> MySQL: UPDATE cart_items
  end
else Remove item
  CartServlet -> CartService: removeItem(customerId, cartItemId)
  CartService -> CartDAO: deleteCartItem(cartItemId, cartId)
  CartDAO -> MySQL: DELETE cart_item
end
CartServlet -> CartService: getCartItems(customerId)
CartService -> CartDAO: findByCustomerId(customerId)
CartDAO -> MySQL: SELECT cart summary rows
CartService --> CartServlet: refreshed items
CartServlet -> JSP: forward refreshed cart or error
@enduml
